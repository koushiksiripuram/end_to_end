pipeline {

    agent any

    environment {

        IMAGE_NAME = "koushiksiripuram/ghost-app"
        IMAGE_TAG = "${BUILD_NUMBER}"

        EC2_HOST ="${env.EC2_HOST}"
        S3_BUCKET = "${env.S3_BUCKET}"
        ALERT_EMAIL = "${env.ALERT_EMAIL}"
        TF_lOCK_TABLE = "${env.TF_LOCK_TABLE}"
    }

    stages {

        stage('Build Docker Image') {

            steps {

                sh "docker rmi $IMAGE_NAME:$IMAGE_TAG || true"

                sh """
                docker build --no-cache \
                -f app/Dockerfile -t $IMAGE_NAME:$IMAGE_TAG .
                """
            }
        }

        stage('Docker Hub Login') {

            steps {

                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {

                    sh '''
                    echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                    '''
                }
            }
        }

        stage('Push Docker Image') {

            steps {

                sh "docker push $IMAGE_NAME:$IMAGE_TAG"
            }
        }

        stage('Terraform Init') {

            steps {

                dir('terraform') {

                    sh '''
                    terraform init \
            -backend-config="bucket=$S3_BUCKET" \
            -backend-config="dynamodb_table=$TF_LOCK_TABLE"
                    '''
                    sh 'terraform plan -var="public_ip=$EC2_HOST" -var="mail_endpoint=$ALERT_EMAIL"'
                }
            }
        }

        stage('Terraform Apply') {

            steps {

                dir('terraform') {

                    sh 'terraform apply -auto-approve -var="public_ip=$EC2_HOST" -var="mail_endpoint=$ALERT_EMAIL"'
                    script {
    env.APP_IP = sh(
        script: 'terraform output -raw app_private_ip',
        returnStdout: true
    ).trim()
}

echo "APP_IP=${env.APP_IP}"
                }
            }
        }

        stage('Wait For EC2') {

            steps {

                sh 'sleep 60'
            }
        }
        


        stage('Deploy To EC2') {

            steps {

                sh """
        aws s3 cp s3://$S3_BUCKET/master.pem /tmp/master.pem
        chmod 400 /tmp/master.pem
        aws s3 cp s3://$S3_BUCKET/certbot-conf.tar.gz .
        aws s3 cp s3://$S3_BUCKET/ghost.env ghost.env
        scp -o StrictHostKeyChecking=no \
        -i /tmp/master.pem \
        certbot-conf.tar.gz ghost.env \
        ubuntu@$APP_IP:/home/ubuntu/

        ssh -o StrictHostKeyChecking=no \
        -i /tmp/master.pem ubuntu@$APP_IP <<
        sudo mkdir -p /data

        if ! mountpoint -q /data; then

            if ! blkid /dev/nvme1n1 > /dev/null 2>&1; then
                sudo mkfs.ext4 /dev/nvme1n1
            fi

            sudo mount /dev/nvme1n1 /data

            grep -q "/data " /etc/fstab || \
            echo '/dev/nvme1n1 /data ext4 defaults,nofail 0 2' | sudo tee -a /etc/fstab
        fi

        sudo mkdir -p /data/ghost
        sudo mkdir -p /data/mysql

        sudo chown -R 999:999 /data/mysql
        sudo chmod -R 755 /data/mysql
        sudo chown -R 999:999 /data/ghost
        sudo chmod -R 755 /data/ghost
        rm -rf app

        git clone https://github.com/koushiksiripuram/end_to_end.git app

        mv /home/ubuntu/certbot-conf.tar.gz /home/ubuntu/app/docker/
        mv /home/ubuntu/ghost.env /home/ubuntu/app/docker/.env

        cd /home/ubuntu/app/docker

        tar -xzvf certbot-conf.tar.gz

        cd ../scripts

        chmod +x install.sh
        ./install.sh

        sudo systemctl enable docker

        sudo systemctl start docker

        cd ../docker
        # First deployment bootstrap
if [ ! -f /data/current-color ]; then
    echo blue | sudo tee /data/current-color
fi

CURRENT=\$(cat /data/current-color)

if [ "\$CURRENT" = "blue" ]; then
    DEPLOY_TARGET="green"
else
    DEPLOY_TARGET="blue"
fi

echo "Current: \$CURRENT"
echo "Deploying: \$DEPLOY_TARGET"

# Update image tags
sed -i '/ghost-blue:/,/container_name:/ s|image: .*|image: koushiksiripuram/ghost-app:'"${IMAGE_TAG}"'|' docker-compose.yaml

sed -i '/ghost-green:/,/container_name:/ s|image: .*|image: koushiksiripuram/ghost-app:'"${IMAGE_TAG}"'|' docker-compose.yaml

sudo docker compose pull

sudo docker compose up -d ghost-\$DEPLOY_TARGET

echo \$DEPLOY_TARGET > /tmp/deploy-target
"""
            }
        }

        stage('Health Check') {

    steps {

        sh """

ssh -o StrictHostKeyChecking=no \
-i /tmp/master.pem ubuntu@$APP_IP

TARGET=\$(cat /tmp/deploy-target)

sleep 30
cd /home/ubuntu/app/docker
for i in $(seq 1 20)
do
    if sudo docker exec ghost-nginx \
       wget -qO- http://ghost-\$TARGET:2368 >/dev/null 2>&1
    then

        echo "Health check passed"

        CURRENT=\$(cat /data/current-color)

        if [ "\$TARGET" = "green" ]; then

            sed -i 's/server ghost-blue:2368;/server ghost-green:2368;/g' nginx/default.conf

        else

            sed -i 's/server ghost-green:2368;/server ghost-blue:2368;/g' nginx/default.conf

        fi

        sudo docker exec ghost-nginx nginx -s reload

        echo \$TARGET | sudo tee /data/current-color

        sudo docker rm -f ghost-\$CURRENT || true

        exit 0
    fi

    sleep 5
done

echo "Deployment failed"
exit 1
"""
    }
}


    }

    post {

        success {

            echo 'Deployment completed successfully!'
        }

        failure {

            echo 'Pipeline failed !'
        }
    }
}
