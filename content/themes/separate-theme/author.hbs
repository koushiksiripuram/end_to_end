{{!< default}}

<div class="container">
  <div class="author-header">
    {{#if profile_image}}
      <img src="{{profile_image}}" alt="{{name}}" class="author-header-avatar">
    {{/if}}
    <div>
      <h1>{{name}}</h1>
      {{#if bio}}<p>{{bio}}</p>{{/if}}
      <p class="author-stat">
        <span>{{post_count}}</span> posts published
      </p>
    </div>
  </div>
</div>

<section class="posts-section">
  <div class="container">
    <p class="section-label">// posts by {{name}}</p>
    <div class="post-grid">
      {{#foreach posts}}
        {{> post-card}}
      {{/foreach}}
    </div>
  </div>
</section>

{{pagination}}
