{{!< default}}

<article>

  <header class="post-header">
    <div class="container">
      {{#if tags}}
      <div class="post-tags">
        {{#foreach tags}}
          <a href="{{url}}" class="post-tag">{{name}}</a>
        {{/foreach}}
      </div>
      {{/if}}

      <h1 class="post-title">{{title}}</h1>

      <div class="post-meta-row">
        {{#primary_author}}
          {{#if profile_image}}
            <img src="{{profile_image}}" alt="{{name}}" class="author-avatar">
          {{/if}}
          <a href="{{url}}" class="author-name">{{name}}</a>
        {{/primary_author}}
        <span>{{date format="MMM DD, YYYY"}}</span>
        {{#if reading_time}}
          <span class="reading-time">{{reading_time}}</span>
        {{/if}}
      </div>
    </div>
  </header>

  {{#if feature_image}}
  <div class="post-feature-image">
    <div class="container">
      <img src="{{feature_image}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
    </div>
  </div>
  {{/if}}

  <div class="post-content">
    <div class="container">
      <div class="gh-content">
        {{content}}
      </div>

      {{#primary_author}}
      <div class="author-box">
        {{#if profile_image}}
          <img src="{{profile_image}}" alt="{{name}}" class="author-box-avatar">
        {{/if}}
        <div>
          <p class="author-box-name">{{name}}</p>
          {{#if bio}}<p class="author-box-bio">{{bio}}</p>{{/if}}
        </div>
      </div>
      {{/primary_author}}
    </div>
  </div>

</article>
